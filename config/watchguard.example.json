{
  "device_id": "podman-watchguard-demo",
  "sample_interval_seconds": 2,
  "temperature_control": {
    "fan_on_celsius": 34.0,
    "fan_off_celsius": 30.0,
    "critical_celsius": 42.0
  },
  "humidity": {
    "warning_percent": 75.0,
    "fan_off_percent": 70.0
  },
  "power": {
    "low_voltage": 4.75,
    "high_current_ma": 950
  },
  "relay": {
    "trigger_delay_seconds": 30,
    "power_off_seconds": 10,
    "cooldown_seconds": 300
  },
  "simulation": {
    "enabled": true,
    "temperature_celsius": 36.5,
    "humidity_percent": 61.0,
    "voltage": 5.05,
    "current_ma": 420,
    "tamper_open": false
  },
  "hardware": {
    "sysfs_root": "/sys",
    "climate": {
      "driver": "iio",
      "iio_name": "dht11",
      "attempts": 3,
      "retry_delay_seconds": 2.0
    },
    "power": {
      "driver": "smbus",
      "i2c_bus": 1,
      "i2c_address": "0x40",
      "hwmon_name": "ina219",
      "shunt_ohms": 0.1
    },
    "tamper": {
      "gpio_chip": "/dev/gpiochip0",
      "gpio_line": 17,
      "bias": "pull-up",
      "open_level": "high"
    },
    "actuators": {
      "gpio_chip": "/dev/gpiochip0",
      "lines": {
        "fan": 27,
        "buzzer": 18,
        "led_green": 22,
        "led_blue": 23,
        "led_red": 24,
        "relay": 25
      },
      "active_low": []
    }
  }
}
