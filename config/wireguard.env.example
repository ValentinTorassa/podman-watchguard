# Copy to ~/.config/podman-watchguard/wireguard.env and adjust; do not commit
# the real file. Variables: https://docs.linuxserver.io/images/docker-wireguard/
# Keys are not configured here: the container generates them in its volume.

TZ=America/Argentina/Buenos_Aires
# Public DNS name or IP that peers dial. If unset, the image looks up the
# public IP through icanhazip.com on every start.
SERVERURL=vpn.example.net
SERVERPORT=51820
# Number of peers, or comma-separated alphanumeric peer names.
PEERS=laptop,phone
INTERNAL_SUBNET=10.13.13.0
# "auto" points peers at CoreDNS inside the container, which forwards to the
# pod's resolver. It does not filter anything.
PEERDNS=auto
# Full tunnel. IPv6 is captured and dropped: the tunnel has no IPv6 route.
ALLOWEDIPS=0.0.0.0/0, ::/0
