FROM docker.io/library/python:3.12-slim

WORKDIR /app
COPY gitops-agent/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY gitops-agent/watchguard_monitor.py gitops-agent/watchguard_hardware.py /app/
COPY config/watchguard.example.json /app/config/watchguard.example.json

ENTRYPOINT ["python", "/app/watchguard_monitor.py"]
