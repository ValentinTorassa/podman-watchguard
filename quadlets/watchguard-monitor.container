[Unit]
Description=Podman Watchguard IoT monitor
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/podman-watchguard-monitor:local
ContainerName=watchguard-monitor
Volume=%h/.config/podman-watchguard/watchguard.json:/app/config/watchguard.json:ro
Exec=--config /app/config/watchguard.json
AutoUpdate=local
# Hardware mode: reed switch, fan, buzzer, LED and relay (GPIO) and INA219
# (I2C). The "-" prefix skips a device that does not exist, so simulation mode
# still starts anywhere.
AddDevice=-/dev/gpiochip0
AddDevice=-/dev/i2c-1
# Rootless access to those nodes through the host user's gpio and i2c groups
# (needs crun). The DHT22 is read from sysfs, which needs no device.
GroupAdd=keep-groups

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
